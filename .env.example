# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local. Vite exposes ONLY variables that start with VITE_ to the browser.

# --- Supabase (public, safe for frontend: anon key only, never service_role) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Backend only (never prefix with VITE_) ---
PORT=3001
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
